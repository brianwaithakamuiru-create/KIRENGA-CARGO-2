rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isAuthenticated() && userDoc().role == 'admin';
    }
    function isStaff() {
      return isAuthenticated() && userDoc().role in ['admin', 'operations', 'dispatch', 'logistics', 'finance', 'documentation', 'fleet', 'support', 'hr'];
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isStaff();
      allow write: if isAdmin();
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']);
    }
    match /bookings/{id} {
      allow read: if isAuthenticated() && (isStaff() || resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isStaff();
    }
    match /shipments/{id} {
      allow read: if isAuthenticated() && (isStaff() || resource.data.customerId == request.auth.uid || resource.data.driverId == request.auth.uid);
      allow write: if isStaff();
    }
    match /vehicles/{id} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.currentDriverId == request.auth.uid);
      allow write: if isAdmin() || userDoc().role == 'fleet';
    }
    match /notifications/{id} {
      allow read, update: if isOwner(resource.data.userId);
      allow create: if isStaff();
    }
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
